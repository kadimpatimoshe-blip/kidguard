rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Hardened Global Helpers
    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Entity Validations
    function isValidParent(data) {
      return data.keys().hasAll(['uid', 'email']) &&
             data.keys().hasOnly(['uid', 'email', 'createdAt']) &&
             data.uid == request.auth.uid &&
             data.email is string && data.email.size() <= 100;
    }

    function isValidChildDevice(data) {
      return data.keys().hasAll(['deviceId', 'pairingCode', 'parentUid', 'status']) &&
             data.keys().hasOnly(['deviceId', 'pairingCode', 'parentUid', 'status', 'deviceModelName', 'isOnline', 'lastSeen', 'updatedAt']) &&
             data.deviceId is string && data.deviceId.size() <= 128 &&
             data.pairingCode is string && data.pairingCode.size() >= 4 && data.pairingCode.size() <= 12 &&
             data.status in ['pending', 'active', 'synced', 'unlinked'];
    }

    // Collection Rules
    match /parents/{parentUid} {
      allow get: if isSignedIn() && request.auth.uid == parentUid;
      allow create: if isSignedIn() && request.auth.uid == parentUid && isValidParent(incoming()) && incoming().createdAt == request.time;
      allow update: if isSignedIn() && request.auth.uid == parentUid && isValidParent(incoming()) && (
        incoming().diff(existing()).affectedKeys().hasOnly(['email'])
      );
      
      match /children/{deviceId} {
        allow list, get: if isSignedIn() && request.auth.uid == parentUid;
        allow create: if isSignedIn() && request.auth.uid == parentUid && isValidId(deviceId) && isValidChildDevice(incoming()) && incoming().parentUid == parentUid;
        allow update: if isSignedIn() && request.auth.uid == parentUid && isValidChildDevice(incoming()) && (
          incoming().diff(existing()).affectedKeys().hasOnly(['status', 'isOnline', 'lastSeen', 'updatedAt'])
        );
        allow delete: if isSignedIn() && request.auth.uid == parentUid;
      }
    }

    match /devices/{pairingCode} {
      allow get: if true; // Public for pairing discovery
      allow create: if isSignedIn() && isValidChildDevice(incoming());
      allow update: if isSignedIn() && (
        // Allow parents to claim device
        (incoming().parentUid == request.auth.uid && existing().parentUid == '') ||
        // Allow current parent to update status
        (existing().parentUid == request.auth.uid && isValidChildDevice(incoming()))
      );
    }
  }
}
