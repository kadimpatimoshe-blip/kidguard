{
  "rules": {
    ".read": "auth != null",
    ".write": "auth != null",
    "pending_binds": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },
    "parents": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        ".write": "auth != null && auth.uid == $uid",
        "children": {
          "$childId": {
            ".read": "auth != null && auth.uid == $uid",
            ".write": "auth != null && auth.uid == $uid"
          }
        }
      }
    },
    "devices": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && (!data.exists() || data.child('parentUid').val() == auth.uid || newData.child('parentUid').val() == auth.uid)"
      }
    },
    "pairings": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && (!data.exists() || data.child('parentUid').val() == auth.uid || newData.child('parentUid').val() == auth.uid)"
      }
    },
    "pairing_codes": {
      "$deviceId": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },
    "user_pairing_codes": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        ".write": "auth != null && auth.uid == $uid"
      }
    },
    "control": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    }
  }
}
